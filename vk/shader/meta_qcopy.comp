#version 450
// M13 meta: vkCmdCopyQueryPoolResults. Pool entry = 16 bytes {u32 available, u32 pad, u64 value}.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Q { uvec4 e[]; } pool;     // x = available, y = pad, z/w = value lo/hi
layout(set = 0, binding = 1, std430) buffer D { uint d[]; } dst;
layout(push_constant) uniform P {
   uint first, count;        // query indices within the pool
   uint dst_off, dst_stride; // bytes
   uint flags;               // VK_QUERY_RESULT_*: 64 = 1, WAIT = 2, WITH_AVAILABILITY = 4, PARTIAL = 8
} p;
void main() {
   uint i = gl_GlobalInvocationID.x;
   if (i >= p.count) return;
   uvec4 q = pool.e[p.first + i];
   bool avail = q.x != 0u;
   uint o = (p.dst_off + i * p.dst_stride) >> 2;
   bool is64 = (p.flags & 1u) != 0u;
   if (avail || (p.flags & 8u) != 0u) {
      if (is64) { dst.d[o] = q.z; dst.d[o + 1u] = q.w; o += 2u; }
      else { dst.d[o] = q.w != 0u ? 0xffffffffu : q.z; o += 1u; }
   } else {
      o += is64 ? 2u : 1u;
   }
   if ((p.flags & 4u) != 0u) {
      if (is64) { dst.d[o] = avail ? 1u : 0u; dst.d[o + 1u] = 0u; }
      else dst.d[o] = avail ? 1u : 0u;
   }
}
