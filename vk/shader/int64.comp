#version 450
#extension GL_ARB_gpu_shader_int64 : require
// R4-B2 shaderInt64: 64-bit add/mul/shift/divide/compare/bitops through 64-bit SSBO loads and stores.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer A { uint64_t a[]; };
layout(set = 0, binding = 1, std430) buffer O { uint64_t o[]; };
void main() {
   uint i = gl_LocalInvocationIndex;
   uint64_t x = a[i], y = a[i + 64u];
   int64_t sx = int64_t(x);
   o[i * 8u + 0u] = x + y;
   o[i * 8u + 1u] = x * y;
   o[i * 8u + 2u] = (x << (i & 63u)) ^ (y >> ((i * 7u) & 63u));
   o[i * 8u + 3u] = (x ^ y) - 1ul;
   o[i * 8u + 4u] = uint64_t(sx >> int64_t(i & 31u));          // arithmetic shift
   o[i * 8u + 5u] = x < y ? 1ul : 2ul;
   o[i * 8u + 6u] = uint64_t(int64_t(sx < int64_t(y)) ) + (x & y) + (x | 3ul);
   o[i * 8u + 7u] = x * 3ul + y * 5ul;
}
