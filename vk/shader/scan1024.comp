#version 450
// Inclusive prefix sum of 1024 uints (the GL 4.3 workgroup width) per workgroup (Hillis-Steele in shared memory, barriers).
layout(local_size_x = 1024) in;
layout(set = 0, binding = 0, std430) readonly buffer In { uint src[]; };
layout(set = 0, binding = 1, std430) buffer Out { uint dst[]; };
shared uint t[1024];
void main() {
   uint l = gl_LocalInvocationID.x;
   uint g = gl_GlobalInvocationID.x;
   t[l] = src[g];
   barrier();
   for (uint off = 1; off < 1024; off <<= 1) {
      uint v = l >= off ? t[l - off] : 0u;
      barrier();
      t[l] += v;
      barrier();
   }
   dst[g] = t[l];
}
