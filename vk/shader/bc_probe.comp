#version 450
// R4-M7 hardware test probe: texelFetch every texel of one level of a (BC) sampled image into an SSBO of uvec2, raw packed:
// kind 0: packUnorm4x8, 1: packSnorm4x8, 2: RGBA16F as two packHalf2x16. Used by tests/t_bc_hw.c.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(set = 0, binding = 1, std430) buffer O { uvec2 o[]; };
layout(push_constant) uniform P { uint w, h, level, kind, obase; } p;
void main() {
   uint i = gl_GlobalInvocationID.x;
   if (i >= p.w * p.h) return;
   if (p.kind == 10u) { o[p.obase + i] = uvec2(0x12345678u + i, 0u); return; }   // bisect: pure SSBO write
   vec4 v;
   if (p.kind == 11u) v = texelFetch(tex, ivec2(int(i % p.w), int(i / p.w)), 0);   // constant lod
   else if (p.kind == 12u) v = textureLod(tex, (vec2(i % p.w, i / p.w) + 0.5) / vec2(p.w, p.h), float(p.level));
   else v = textureLod(tex, (vec2(i % p.w, i / p.w) + 0.5) / vec2(p.w, p.h), float(p.level));   // dynamic-lod texelFetch returns 0 on the CMF (bisected 2026-11-17), use nearest textureLod
   uvec2 r;
   if (p.kind == 0u || p.kind >= 11u) r = uvec2(packUnorm4x8(v), 0u);
   else if (p.kind == 1u) r = uvec2(packSnorm4x8(v), 0u);
   else r = uvec2(packHalf2x16(v.xy), packHalf2x16(v.zw));
   o[p.obase + i] = r;
}
