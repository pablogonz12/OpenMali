#version 450
//@HEADER@
// R4-M7 BC decode: BC7 -> RGBA8 linear shadow. One invocation = one 4x4 block. Same arithmetic as Mesa's
// util/format/texcompress_bptc_tmp.h (bit replication expansion, 64-step weights, anchors, rotation, index selection).
// Reserved mode (first byte 0) decodes to (0,0,0,0).
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer S { uint d[]; } src;
layout(set = 0, binding = 1, std430) buffer D { uint d[]; } dst;
layout(push_constant) uniform P {
   uint src_off, src_row, src_slice;
   uint dst_off, dst_row, dst_slice;   // dst row pitch multiple of 16 bytes
   uint bw, bh, bz;
   uint mode;                          // unused
   uint pad0, pad1;
} p;

//@TABLES@

const uint W2[4] = uint[](0u, 21u, 43u, 64u);
const uint W3[8] = uint[](0u, 9u, 18u, 27u, 37u, 46u, 55u, 64u);
const uint W4[16] = uint[](0u, 4u, 9u, 13u, 17u, 21u, 26u, 30u, 34u, 38u, 43u, 47u, 51u, 55u, 60u, 64u);

uvec4 blk;

uint gb(uint pos, uint n) {
   if (n == 0u) return 0u;
   uint wi = pos >> 5, sh = pos & 31u;
   uint v = blk[wi] >> sh;
   if (sh + n > 32u) v |= blk[min(wi + 1u, 3u)] << (32u - sh);
   return v & ((1u << n) - 1u);
}

uint weight(uint bits, uint idx) { return bits == 2u ? W2[idx] : (bits == 3u ? W3[idx] : W4[idx]); }
uint lerp(uint a, uint b, uint bits, uint idx) { uint w = weight(bits, idx); return ((64u - w) * a + w * b + 32u) >> 6; }
uint expand(uint v, uint n) { return ((v << (8u - n)) | (v >> (2u * n - 8u))) & 255u; }

void main() {
   uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (32768u * 64u);
   if (i >= p.bw * p.bh * p.bz) return;
   uint bx = i % p.bw;
   uint r0 = i / p.bw;
   uint by = r0 % p.bh;
   uint z = r0 / p.bh;
   uint so = (p.src_off + z * p.src_slice + by * p.src_row + bx * 16u) >> 2;
   uint dof = p.dst_off + z * p.dst_slice + by * 4u * p.dst_row + bx * 16u;
   blk = uvec4(src.d[so], src.d[so + 1u], src.d[so + 2u], src.d[so + 3u]);

   uint b0 = blk.x & 255u;
   if (b0 == 0u) {
      for (uint r = 0u; r < 4u; r++)
         for (uint c = 0u; c < 4u; c++) dst.d[((dof + r * p.dst_row) >> 2) + c] = 0u;
      return;
   }
   uint mn = uint(findLSB(b0)) + 1u;
   uint mi = MODES[mn - 1u];
   uint nsub = mi & 3u, pb = (mi >> 2) & 7u, hasrot = (mi >> 5) & 1u, hassel = (mi >> 6) & 1u;
   uint ncol = (mi >> 7) & 15u, nal = (mi >> 11) & 15u, epb = (mi >> 15) & 1u, shb = (mi >> 16) & 1u;
   uint nidx = (mi >> 17) & 7u, nsec = (mi >> 20) & 3u;

   uint bo = mn;
   uint part = gb(bo, pb);
   bo += pb;
   uint subsets = nsub == 1u ? 0u : (nsub == 2u ? PART2[part] : PART3[part]);
   uint rot = 0u, sel = 0u;
   if (hasrot != 0u) { rot = gb(bo, 2u); bo += 2u; }
   if (hassel != 0u) { sel = gb(bo, 1u); bo += 1u; }

   uint ep[24];
   for (uint c = 0u; c < 3u; c++)
      for (uint s = 0u; s < nsub; s++)
         for (uint e = 0u; e < 2u; e++) { ep[(s * 2u + e) * 4u + c] = gb(bo, ncol); bo += ncol; }
   for (uint s = 0u; s < nsub; s++)
      for (uint e = 0u; e < 2u; e++) {
         if (nal > 0u) { ep[(s * 2u + e) * 4u + 3u] = gb(bo, nal); bo += nal; }
         else ep[(s * 2u + e) * 4u + 3u] = 255u;
      }
   uint ncomp = nal > 0u ? 4u : 3u;
   if (epb != 0u) {
      for (uint s = 0u; s < nsub; s++)
         for (uint e = 0u; e < 2u; e++) {
            uint pbit = gb(bo, 1u);
            bo += 1u;
            for (uint c = 0u; c < ncomp; c++) ep[(s * 2u + e) * 4u + c] = (ep[(s * 2u + e) * 4u + c] << 1) | pbit;
         }
   } else if (shb != 0u) {
      for (uint s = 0u; s < nsub; s++) {
         uint pbit = gb(bo, 1u);
         bo += 1u;
         for (uint e = 0u; e < 2u; e++)
            for (uint c = 0u; c < ncomp; c++) ep[(s * 2u + e) * 4u + c] = (ep[(s * 2u + e) * 4u + c] << 1) | pbit;
      }
   }
   for (uint k = 0u; k < nsub * 2u; k++) {
      for (uint c = 0u; c < 3u; c++) ep[k * 4u + c] = expand(ep[k * 4u + c], ncol + epb + shb);
      if (nal > 0u) ep[k * 4u + 3u] = expand(ep[k * 4u + 3u], nal + epb + shb);
   }

   uint a1 = nsub == 2u ? ANCH2[part] : (nsub == 3u ? ANCH3A[part] : 255u);
   uint a2 = nsub == 3u ? ANCH3B[part] : 255u;
   for (uint t = 0u; t < 16u; t++) {
      uint before = 0u;
      if (t != 0u) before = 1u + (nsub >= 2u && t > a1 ? 1u : 0u) + (nsub == 3u && t > a2 ? 1u : 0u);
      bool anchor = t == 0u || (nsub >= 2u && a1 == t) || (nsub == 3u && a2 == t);
      uint sec = bo + 16u * nidx - nsub + nsec * t - before;
      uint pri = bo + nidx * t - before;
      uint s = (subsets >> (2u * t)) & 3u;
      uint i0 = gb(pri, nidx - (anchor ? 1u : 0u));
      uint i1 = nsec != 0u ? gb(sec, nsec - (anchor ? 1u : 0u)) : 0u;
      uint ic = sel != 0u ? i1 : i0, bc = sel != 0u ? nsec : nidx;
      uint ia, ba;
      if (nsec != 0u && sel == 0u) { ia = i1; ba = nsec; } else { ia = i0; ba = nidx; }
      uint px[4];
      for (uint c = 0u; c < 3u; c++) px[c] = lerp(ep[s * 8u + c], ep[s * 8u + 4u + c], bc, ic);
      px[3] = lerp(ep[s * 8u + 3u], ep[s * 8u + 7u], ba, ia);
      if (rot != 0u) { uint tmp = px[rot - 1u]; px[rot - 1u] = px[3]; px[3] = tmp; }
      dst.d[((dof + (t >> 2) * p.dst_row) >> 2) + (t & 3u)] = px[0] | (px[1] << 8) | (px[2] << 16) | (px[3] << 24);
   }
}
