#version 450
// M12 meta: scaled / mirrored blit (nearest, bilinear) and MSAA resolve between linear 2D surfaces of 8-bit UNORM or 32-bit float
// texels with 1..4 components. One invocation = one destination pixel. Source coordinates follow Vulkan: texel centres at +0.5,
// source region [sx0,sx1) (may be reversed = mirrored) mapped onto destination region [dx0,dx1).
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer S { uint d[]; } src;
layout(set = 0, binding = 1, std430) buffer D { uint d[]; } dst;
layout(push_constant) uniform P {
   uint src_off, src_row, sample_stride;   // bytes; sample_stride = distance between samples of one pixel (resolve)
   uint dst_off, dst_row, gfmt;
   int sx0, sy0, sx1, sy1;                 // source rectangle (signed: reversed = mirror)
   int dx0, dy0, dx1, dy1;                 // destination rectangle (signed: reversed = mirror)
   int cx0, cy0, cx1, cy1;                 // destination clamp rectangle (the written pixels, dst-space, x1/y1 exclusive)
   int sw, sh;                             // source image size (clamp)
   uint fmt;                               // bits 0-1 ncomp-1, bit2 float32 (else unorm8), bit3 swap R<->B (src and dst differ in BGRA-ness)
   uint mode;                              // 0 nearest, 1 linear, 2 resolve (average of nsamples)
   uint nsamples;
   uint lw;                                // pixels written per row (cx1-cx0)
   // generic path (fmt bit 4): any plain colour format, described per logical channel R,G,B,A:
   // bits 0-7 bit offset in the pixel, 8-13 size, 16-18 type (0 absent, 1 unorm, 2 snorm, 3 uint, 4 sint, 5 float, 6 unsigned 5-bit-exponent float (R11G11B10), 7 shared exponent (E5B9G9R9: mantissa fields; the 5-bit exponent at bit 27 belongs to the pixel, not to a channel))
   uint sch0, sch1, sch2, sch3;
   uint dch0, dch1, dch2, dch3;
} p;
// pad0 (generic path): bits 0-7 src bytes/pixel, 8-15 dst bytes/pixel, 16-17 class (0 float-ish, 1 uint, 2 sint), bit 20 src sRGB, 21 dst sRGB

uint ncomp() { return (p.fmt & 3u) + 1u; }
bool isf() { return (p.fmt & 4u) != 0u; }

vec4 fetch(int x, int y, uint s) {
   x = clamp(x, 0, p.sw - 1);
   y = clamp(y, 0, p.sh - 1);
   uint o = p.src_off + s * p.sample_stride + uint(y) * p.src_row + uint(x) * (isf() ? 4u * ncomp() : ncomp());
   vec4 v = vec4(0.0, 0.0, 0.0, 1.0);
   uint n = ncomp();
   if (isf()) {
      for (uint c = 0u; c < n; c++) v[c] = uintBitsToFloat(src.d[(o >> 2) + c]);
   } else {
      for (uint c = 0u; c < n; c++) {
         uint b = o + c;
         v[c] = float((src.d[b >> 2] >> ((b & 3u) * 8u)) & 0xffu) / 255.0;
      }
   }
   if ((p.fmt & 8u) != 0u) v = v.bgra;
   return v;
}

void put8(uint o, uint v) {
   uint sh = (o & 3u) * 8u;
   atomicAnd(dst.d[o >> 2], ~(0xffu << sh));
   atomicOr(dst.d[o >> 2], v << sh);
}

// ---- generic path ----
uint sch(uint c) { return c == 0u ? p.sch0 : c == 1u ? p.sch1 : c == 2u ? p.sch2 : p.sch3; }
uint dch(uint c) { return c == 0u ? p.dch0 : c == 1u ? p.dch1 : c == 2u ? p.dch2 : p.dch3; }
uint cOff(uint w) { return w & 255u; }
uint cSize(uint w) { return (w >> 8) & 63u; }
uint cType(uint w) { return (w >> 16) & 7u; }
uint lowmask(uint size) { return size >= 32u ? 0xffffffffu : ((1u << size) - 1u); }

uint rdbits(uint baseb, uint off, uint size) {
   uint bp = baseb * 8u + off;
   uint w = bp >> 5, sh = bp & 31u;
   uint v = src.d[w] >> sh;
   if (sh != 0u && sh + size > 32u) v |= src.d[w + 1u] << (32u - sh);
   return v & lowmask(size);
}

void wrbits(uint baseb, uint off, uint size, uint val) {
   uint bp = baseb * 8u + off;
   uint w = bp >> 5, sh = bp & 31u;
   uint m = lowmask(size);
   val &= m;
   if (size == 32u && sh == 0u) { dst.d[w] = val; return; }
   atomicAnd(dst.d[w], ~(m << sh));
   atomicOr(dst.d[w], val << sh);
   if (sh + size > 32u) {
      uint hs = 32u - sh;
      atomicAnd(dst.d[w + 1u], ~(m >> hs));
      atomicOr(dst.d[w + 1u], val >> hs);
   }
}

// E5B9G9R9 encode (Vulkan spec, "Shared exponent"): rgb clamped to [0, 65408], exponent from the largest channel, mantissas rounded to nearest.
// The two powers of two are built from bits (exp2() on the GPU is not exact).
uint rgb9e5_enc(vec3 c) {
   c = vec3(c.x > 0.0 ? min(c.x, 65408.0) : 0.0, c.y > 0.0 ? min(c.y, 65408.0) : 0.0, c.z > 0.0 ? min(c.z, 65408.0) : 0.0);
   float m = max(max(c.x, c.y), c.z);
   int es = max(-16, int((floatBitsToUint(m) >> 23) & 255u) - 127) + 16;   // biased shared exponent; denormals / 0 -> 0
   float rd = uintBitsToFloat(uint(127 - (es - 24)) << 23);                // 1 / 2^(es - 15 - 9)
   if (floor(m * rd + 0.5) >= 512.0) { es++; rd *= 0.5; }
   uvec3 q = uvec3(floor(c * rd + 0.5));
   return (uint(es) << 27) | (q.z << 18) | (q.y << 9) | q.x;
}
int sext(uint v, uint size) { return size >= 32u ? int(v) : (int(v << (32u - size)) >> (32u - size)); }
float ufl_dec(uint raw, uint mb) {
   uint e = raw >> mb, m = raw & ((1u << mb) - 1u);
   float fm = float(m) / float(1u << mb);
   if (e == 0u) return fm * exp2(-14.0);
   if (e < 31u) return (1.0 + fm) * exp2(float(e) - 15.0);
   return m == 0u ? uintBitsToFloat(0x7f800000u) : uintBitsToFloat(0x7fc00000u);
}
uint ufl_enc(float f, uint mb) {
   if (isnan(f)) return (31u << mb) | 1u;
   if (!(f > 0.0)) return 0u;
   if (isinf(f)) return 31u << mb;
   int ex = int((floatBitsToUint(f) >> 23) & 255u) - 127;
   float sc = float(1u << mb);
   if (ex < -14) return uint(round(f * exp2(14.0) * sc));
   uint e = uint(ex + 15);
   uint m = uint(round((f / exp2(float(ex)) - 1.0) * sc));
   if (m >= (1u << mb)) { m = 0u; e++; }
   if (e >= 31u) return 31u << mb;
   return (e << mb) | m;
}
float s2l(float c) { return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4); }
float l2s(float c) { return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(c, 1.0 / 2.4) - 0.055; }
uint gcls() { return (p.gfmt >> 16) & 3u; }

vec4 gfetchf(int x, int y, uint s) {
   x = clamp(x, 0, p.sw - 1);
   y = clamp(y, 0, p.sh - 1);
   uint bs = p.gfmt & 255u;
   uint o = p.src_off + s * p.sample_stride + uint(y) * p.src_row + uint(x) * bs;
   vec4 v = vec4(0.0, 0.0, 0.0, 1.0);
   for (uint c = 0u; c < 4u; c++) {
      uint w = sch(c), t = cType(w), sz = cSize(w);
      if (t == 0u) continue;
      uint raw = rdbits(o, cOff(w), sz);
      float f;
      if (t == 1u) f = float(raw) / float(lowmask(sz));
      else if (t == 2u) f = max(float(sext(raw, sz)) / float(lowmask(sz - 1u)), -1.0);
      else if (t == 6u) f = ufl_dec(raw, sz == 10u ? 5u : 6u);
      else if (t == 7u) f = float(raw) * exp2(float(rdbits(o, 27u, 5u)) - 24.0);
      else if (sz == 32u) f = uintBitsToFloat(raw);
      else f = unpackHalf2x16(raw).x;
      if (c < 3u && (p.gfmt & (1u << 20)) != 0u) f = s2l(f);
      v[c] = f;
   }
   return v;
}

ivec4 gfetchi(int x, int y) {
   x = clamp(x, 0, p.sw - 1);
   y = clamp(y, 0, p.sh - 1);
   uint bs = p.gfmt & 255u;
   uint o = p.src_off + uint(y) * p.src_row + uint(x) * bs;
   ivec4 v = ivec4(0, 0, 0, 1);
   for (uint c = 0u; c < 4u; c++) {
      uint w = sch(c), t = cType(w), sz = cSize(w);
      if (t == 0u) continue;
      uint raw = rdbits(o, cOff(w), sz);
      v[c] = t == 4u ? sext(raw, sz) : int(raw);
   }
   return v;
}

void gmain(uint ox, uint oy_) {
   int oy = int(oy_), oxi = int(ox);
   uint dbs = (p.gfmt >> 8) & 255u;
   uint o = p.dst_off + uint(oy) * p.dst_row + uint(oxi) * dbs;
   float u = (float(oxi) + 0.5 - float(p.dx0)) / float(p.dx1 - p.dx0);
   float w = (float(oy) + 0.5 - float(p.dy0)) / float(p.dy1 - p.dy0);
   float fx = float(p.sx0) + u * float(p.sx1 - p.sx0);
   float fy = float(p.sy0) + w * float(p.sy1 - p.sy0);
   if (gcls() != 0u) {
      ivec4 v = gfetchi(int(floor(fx)), int(floor(fy)));
      for (uint c = 0u; c < 4u; c++) {
         uint dw = dch(c), t = cType(dw), sz = cSize(dw);
         if (t == 0u) continue;
         uint r;
         if (t == 4u) {
            int lo = sz >= 32u ? -2147483647 - 1 : -(1 << (sz - 1u)), hi = sz >= 32u ? 2147483647 : (1 << (sz - 1u)) - 1;
            r = uint(clamp(v[c], lo, hi));
         } else {
            uint uv = uint(v[c]);
            r = min(uv, lowmask(sz));
            if (sch(c) != 0u && cType(sch(c)) == 4u && v[c] < 0) r = 0u;
         }
         wrbits(o, cOff(dw), sz, r);
      }
      return;
   }
   vec4 v;
   if (p.mode == 2u) {
      v = vec4(0.0);
      for (uint s = 0u; s < p.nsamples; s++) v += gfetchf(oxi - p.dx0 + p.sx0, oy - p.dy0 + p.sy0, s);
      v /= float(p.nsamples);
   } else if (p.mode == 0u) {
      v = gfetchf(int(floor(fx)), int(floor(fy)), 0u);
   } else {
      fx -= 0.5; fy -= 0.5;
      int x0 = int(floor(fx)), y0 = int(floor(fy));
      float ax = fx - float(x0), ay = fy - float(y0);
      vec4 a = mix(gfetchf(x0, y0, 0u), gfetchf(x0 + 1, y0, 0u), ax);
      vec4 b = mix(gfetchf(x0, y0 + 1, 0u), gfetchf(x0 + 1, y0 + 1, 0u), ax);
      v = mix(a, b, ay);
   }
   uint e5 = 0u;
   bool e5done = false;
   for (uint c = 0u; c < 4u; c++) {
      uint dw = dch(c), t = cType(dw), sz = cSize(dw);
      if (t == 0u) continue;
      if (t == 7u) {
         if (!e5done) { e5 = rgb9e5_enc(v.rgb); e5done = true; wrbits(o, 27u, 5u, e5 >> 27); }
         wrbits(o, cOff(dw), sz, e5 >> cOff(dw));
         continue;
      }
      float f = v[c];
      if (c < 3u && (p.gfmt & (1u << 21)) != 0u) f = l2s(clamp(f, 0.0, 1.0));
      uint r;
      if (t == 1u) r = uint(clamp(f, 0.0, 1.0) * float(lowmask(sz)) + 0.5);
      else if (t == 2u) r = uint(int(round(clamp(f, -1.0, 1.0) * float(lowmask(sz - 1u)))));
      else if (t == 6u) r = ufl_enc(f, sz == 10u ? 5u : 6u);
      else if (sz == 32u) r = floatBitsToUint(f);
      else r = packHalf2x16(vec2(f, 0.0)) & 0xffffu;
      wrbits(o, cOff(dw), sz, r);
   }
}

void main() {
   uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (32768u * 64u);
   uint total = p.lw * uint(p.cy1 - p.cy0);
   if (i >= total) return;
   int ox = p.cx0 + int(i % p.lw);
   int oy = p.cy0 + int(i / p.lw);
   if ((p.fmt & 16u) != 0u) { gmain(uint(ox), uint(oy)); return; }
   vec4 v;
   if (p.mode == 2u) {
      v = vec4(0.0);
      for (uint s = 0u; s < p.nsamples; s++) v += fetch(ox - p.dx0 + p.sx0, oy - p.dy0 + p.sy0, s);
      v /= float(p.nsamples);
   } else {
      // position of the destination pixel centre in destination space, mapped linearly onto the source rectangle
      float u = (float(ox) + 0.5 - float(p.dx0)) / float(p.dx1 - p.dx0);
      float w = (float(oy) + 0.5 - float(p.dy0)) / float(p.dy1 - p.dy0);
      float fx = float(p.sx0) + u * float(p.sx1 - p.sx0);
      float fy = float(p.sy0) + w * float(p.sy1 - p.sy0);
      if (p.mode == 0u) {
         v = fetch(int(floor(fx)), int(floor(fy)), 0u);
      } else {
         fx -= 0.5; fy -= 0.5;
         int x0 = int(floor(fx)), y0 = int(floor(fy));
         float ax = fx - float(x0), ay = fy - float(y0);
         vec4 a = mix(fetch(x0, y0, 0u), fetch(x0 + 1, y0, 0u), ax);
         vec4 b = mix(fetch(x0, y0 + 1, 0u), fetch(x0 + 1, y0 + 1, 0u), ax);
         v = mix(a, b, ay);
      }
   }
   uint n = ncomp();
   uint bpp = isf() ? 4u * n : n;
   uint o = p.dst_off + uint(oy) * p.dst_row + uint(ox) * bpp;
   for (uint c = 0u; c < n; c++) {
      if (isf()) dst.d[(o >> 2) + c] = floatBitsToUint(v[c]);
      else put8(o + c, uint(clamp(v[c], 0.0, 1.0) * 255.0 + 0.5));
   }
}
