#version 450
// vkCmdDispatchBase test: every invocation records which workgroup / global id it saw, at the slot its (Vulkan) global id addresses.
layout(local_size_x = 8, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer O { uint v[]; } o;
layout(push_constant) uniform P { uint k; } p;
void main()
{
   uint idx = gl_GlobalInvocationID.y * 64u + gl_GlobalInvocationID.x;
   o.v[idx] = p.k + gl_WorkGroupID.x * 1000u + gl_WorkGroupID.y * 10000u + gl_LocalInvocationID.x;
}
