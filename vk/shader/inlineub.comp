#version 450
// R4-B3 inlineUniformBlock: binding 1 = 80-byte inline block, binding 2 = 16-byte inline block, binding 3 = normal UBO.
layout(local_size_x = 1) in;
layout(set=0, binding=0) buffer O { uvec4 o[]; };
layout(set=0, binding=1) uniform A { uvec4 a[5]; };
layout(set=0, binding=2) uniform B { uvec4 b; };
layout(set=0, binding=3) uniform C { uvec4 c; };
void main(){
  for (int i = 0; i < 5; i++) o[i] = a[i];
  o[5] = b;
  o[6] = c;
}
