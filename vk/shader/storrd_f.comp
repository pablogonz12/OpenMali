#version 450
#extension GL_EXT_shader_image_load_formatted : require
layout(local_size_x = 4, local_size_y = 4) in;
layout(set = 0, binding = 0) uniform readonly image2D img;
layout(set = 0, binding = 1) buffer O { uvec4 o[]; };
void main() { ivec2 p = ivec2(gl_GlobalInvocationID.xy); vec4 t = imageLoad(img, p); o[p.y * 4 + p.x] = floatBitsToUint(t); }
