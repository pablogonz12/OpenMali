#version 450
// M12 meta: rectangle copy / constant fill between two linear surfaces (buffers or linear images).
// One invocation = one element (texel/block of `bpt` bytes). Word path when every offset/pitch/bpt is a multiple of 4,
// else a byte path with atomic read-modify-write of the destination word (so neighbouring invocations cannot race).
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer S { uint d[]; } src;
layout(set = 0, binding = 1, std430) buffer D { uint d[]; } dst;
layout(push_constant) uniform P {
   uint src_off, src_row, src_slice;
   uint dst_off, dst_row, dst_slice;
   uint ex, ey, ez;
   uint bpt;
   uint flags;          // bit0: word path, bit1: constant source, bit2: src tiled, bit3: dst tiled
   uint pad;
   uvec4 cst;
} p;

uint ld8(uint o) { return (src.d[o >> 2] >> ((o & 3u) * 8u)) & 0xffu; }
void st8(uint o, uint v) {
   uint sh = (o & 3u) * 8u;
   atomicAnd(dst.d[o >> 2], ~(0xffu << sh));
   atomicOr(dst.d[o >> 2], v << sh);
}

// 16x16 u-interleaved tile: per bit i, bit 2i = x_i ^ y_i, bit 2i+1 = y_i
// (copy: cst = src x0, src y0, dst x0, dst y0 of tiled surfaces; a constant fill has no source and tiled dst origin 0.. see plan)
uint toff(uint base, uint row, uint x, uint y) {
   uint ix = x & 15u, iy = y & 15u, u = 0u;
   for (uint i = 0u; i < 4u; i++) u |= ((((ix >> i) ^ (iy >> i)) & 1u) << (2u * i)) | (((iy >> i) & 1u) << (2u * i + 1u));
   return base + (y >> 4) * row + (x >> 4) * 256u * p.bpt + u * p.bpt;
}

uint cw(uint k) { k &= 3u; return k == 0u ? p.cst.x : (k == 1u ? p.cst.y : (k == 2u ? p.cst.z : p.cst.w)); }

void main() {
   uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (32768u * 64u);
   uint total = p.ex * p.ey * p.ez;
   if (i >= total) return;
   uint x = i % p.ex;
   uint r = i / p.ex;
   uint y = r % p.ey;
   uint z = r / p.ey;
   uint so = p.src_off + z * p.src_slice + y * p.src_row + x * p.bpt;
   uint dof = p.dst_off + z * p.dst_slice + y * p.dst_row + x * p.bpt;
   if ((p.flags & 4u) != 0u) so = toff(p.src_off + z * p.src_slice, p.src_row, p.cst.x + x, p.cst.y + y);
   if ((p.flags & 8u) != 0u) dof = toff(p.dst_off + z * p.dst_slice, p.dst_row, (p.flags & 2u) != 0u ? x : p.cst.z + x, (p.flags & 2u) != 0u ? y : p.cst.w + y);
   bool cst = (p.flags & 2u) != 0u;
   if ((p.flags & 1u) != 0u) {
      for (uint w = 0u; w < p.bpt / 4u; w++)
         dst.d[(dof >> 2) + w] = cst ? cw(w) : src.d[(so >> 2) + w];
   } else {
      for (uint b = 0u; b < p.bpt; b++) {
         uint v = cst ? ((cw(b >> 2) >> ((b & 3u) * 8u)) & 0xffu) : ld8(so + b);
         st8(dof + b, v);
      }
   }
}
