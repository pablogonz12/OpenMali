#version 460
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 1) in;
layout(push_constant) uniform PC { uvec2 a; vec2 pf; } pc;
layout(buffer_reference, std430) buffer B { uint x[]; };
// 8-bit add of a constant onto a byte of packHalf2x16: va_resolve_swizzles asserted
void main() { B x = B(pc.a); uint8_t b = uint8_t(packHalf2x16(vec2(1.0, pc.pf.y))); x.x[uint(b + uint8_t(1))] = 3u; }
