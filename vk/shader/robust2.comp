#version 450
/* robustness2 buffer bounds: every access below is exactly one element past the end of its descriptor (offset == size), the
 * boundary the spec defines as out of bounds, plus a null descriptor. With robustBufferAccess2 the loads must read 0, the store
 * and the atomic must be discarded (and the atomic must return 0), and the null descriptor must behave the same.
 * layout: set 0 binding 0 = 64-byte result SSBO (in bounds), 1 = 64-byte SSBO, 2 = 64-byte UBO, 3 = null SSBO,
 * 4 = 4-texel R32_UINT texel buffer. */
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Out { uint r[]; };
layout(set = 0, binding = 1, std430) buffer S { uint s[]; };
layout(set = 0, binding = 2, std140) uniform U { uvec4 u[4]; };
layout(set = 0, binding = 3, std430) buffer N { uint n[]; };
layout(set = 0, binding = 4) uniform samplerBuffer T;
void main()
{
   uint i = 0;
   r[i++] = s[16];                          /* ssbo load  OOB -> 0 */
   s[16] = 0xdeadbeefu;                     /* ssbo store OOB -> discarded */
   r[i++] = atomicAdd(s[16], 1u);           /* ssbo atomic OOB -> 0, discarded */
   r[i++] = u[3].x;                         /* ubo load in bounds (word 48 of 64) -> 0x33333333 */
   uint j = 4u;                             /* dynamic: an OOB UBO index is a runtime index, not a compile error */
   r[i++] = u[j].x;                         /* ubo load OOB -> 0 */
   r[i++] = floatBitsToUint(texelFetch(T, 4).x);   /* texel fetch OOB -> 0 */
   r[i++] = n[0];                           /* null descriptor read -> 0 */
   n[0] = 1u;                               /* null descriptor write -> discarded */
}
