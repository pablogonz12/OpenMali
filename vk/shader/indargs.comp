#version 450
/* A compute job writes one VkDrawIndirectCommand into a storage buffer (t_vk_draw --only indirect_gpu). The host leaves
 * that buffer zeroed at record time, so a driver that reads the command through the CPU mapping at submit sees
 * vertexCount = 0 and draws nothing: only a draw whose arguments are loaded by the command stream can draw the triangle.
 * One workgroup, one invocation: {vertexCount, instanceCount, firstVertex, firstInstance} = {3, 1, 0, 0}. */
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer Args { uvec4 cmd; };
void main() { cmd = uvec4(3u, 1u, 0u, 0u); }
