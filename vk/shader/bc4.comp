#version 450
// R4-M7 BC decode: BC4 (R) and BC5 (RG), UNORM and SNORM, 8 bit per channel linear shadow (R8 / RG8). One invocation = one 4x4 block.
// Math is Mesa's util/rgtc: 8 or 6+2 interpolants, truncating division; SNORM special values -128 / 127.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer S { uint d[]; } src;
layout(set = 0, binding = 1, std430) buffer D { uint d[]; } dst;
layout(push_constant) uniform P {
   uint src_off, src_row, src_slice;
   uint dst_off, dst_row, dst_slice;
   uint bw, bh, bz;
   uint mode;                          // bit0: signed, bit1: two channels (BC5)
   uint pad0, pad1;
} p;

uint bits(uvec2 v, uint pos, uint n) {
   uint lo = pos < 32u ? (v.x >> pos) : (v.y >> (pos - 32u));
   if (pos < 32u && pos + n > 32u) lo |= v.y << (32u - pos);
   return lo & ((1u << n) - 1u);
}

// returns the decoded byte (two's complement for signed)
uint dec(uvec2 v, uint t, bool sg) {
   int a0, a1;
   if (sg) { a0 = bitfieldExtract(int(v.x), 0, 8); a1 = bitfieldExtract(int(v.x), 8, 8); }
   else { a0 = int(v.x & 255u); a1 = int((v.x >> 8) & 255u); }
   uint code = bits(v, 16u + 3u * t, 3u);
   int r;
   if (code == 0u) r = a0;
   else if (code == 1u) r = a1;
   else if (a0 > a1) r = (a0 * int(8u - code) + a1 * int(code - 1u)) / 7;
   else if (code < 6u) r = (a0 * int(6u - code) + a1 * int(code - 1u)) / 5;
   else if (code == 6u) r = sg ? -128 : 0;
   else r = sg ? 127 : 255;
   return uint(r) & 255u;
}

void main() {
   uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (32768u * 64u);
   if (i >= p.bw * p.bh * p.bz) return;
   uint bx = i % p.bw;
   uint r0 = i / p.bw;
   uint by = r0 % p.bh;
   uint z = r0 / p.bh;
   bool sg = (p.mode & 1u) != 0u, two = (p.mode & 2u) != 0u;
   uint so = (p.src_off + z * p.src_slice + by * p.src_row + bx * (two ? 16u : 8u)) >> 2;
   uint tb = two ? 8u : 4u;                                // dst bytes per block row
   uint dof = p.dst_off + z * p.dst_slice + by * 4u * p.dst_row + bx * tb;
   uvec2 vr = uvec2(src.d[so], src.d[so + 1u]);
   uvec2 vg = two ? uvec2(src.d[so + 2u], src.d[so + 3u]) : vr;
   for (uint r = 0u; r < 4u; r++) {
      uint o = (dof + r * p.dst_row) >> 2;
      if (!two) {
         uint w = 0u;
         for (uint c = 0u; c < 4u; c++) w |= dec(vr, r * 4u + c, sg) << (8u * c);
         dst.d[o] = w;
      } else {
         uint w0 = 0u, w1 = 0u;
         for (uint c = 0u; c < 2u; c++) {
            uint t = r * 4u + c;
            w0 |= (dec(vr, t, sg) | (dec(vg, t, sg) << 8)) << (16u * c);
            w1 |= (dec(vr, t + 2u, sg) | (dec(vg, t + 2u, sg) << 8)) << (16u * c);
         }
         dst.d[o] = w0;
         dst.d[o + 1u] = w1;
      }
   }
}
