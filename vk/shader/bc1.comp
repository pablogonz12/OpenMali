#version 450
// R4-M7 BC decode: BC1 (mode 0), BC2 (mode 1), BC3 (mode 2) compressed linear surface -> RGBA8 linear shadow surface.
// One invocation = one 4x4 block (16 texels, 4 rows of 16 bytes). Math is Mesa's software decoder (util/format s3tc, rgtc): 5/6-bit
// expansion by bit replication, 1/3 and 2/3 interpolation by truncating integer division.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer S { uint d[]; } src;
layout(set = 0, binding = 1, std430) buffer D { uint d[]; } dst;
layout(push_constant) uniform P {
   uint src_off, src_row, src_slice;   // bytes: first block, block row pitch, z/layer pitch
   uint dst_off, dst_row, dst_slice;   // bytes: first texel (4-aligned), texel row pitch (multiple of 16), z/layer pitch
   uint bw, bh, bz;                    // blocks in the region
   uint mode;                          // 0 BC1 RGBA (3-colour index 3 = transparent), 1 BC2, 2 BC3, 3 BC1 RGB (alpha forced 1)
   uint pad0, pad1;
} p;

uvec3 exp565(uint c) {
   uint r = (c >> 11) & 31u, g = (c >> 5) & 63u, b = c & 31u;
   return uvec3((r << 3) | (r >> 2), (g << 2) | (g >> 4), (b << 3) | (b >> 2));
}

uint bits(uvec2 v, uint pos, uint n) {
   uint lo = pos < 32u ? (v.x >> pos) : (v.y >> (pos - 32u));
   if (pos < 32u && pos + n > 32u) lo |= v.y << (32u - pos);
   return lo & ((1u << n) - 1u);
}

uint bc4u(uvec2 v, uint t) {
   int a0 = int(v.x & 255u), a1 = int((v.x >> 8) & 255u);
   uint code = bits(v, 16u + 3u * t, 3u);
   if (code == 0u) return uint(a0);
   if (code == 1u) return uint(a1);
   if (a0 > a1) return uint((a0 * int(8u - code) + a1 * int(code - 1u)) / 7);
   if (code < 6u) return uint((a0 * int(6u - code) + a1 * int(code - 1u)) / 5);
   return code == 6u ? 0u : 255u;
}

void main() {
   uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (32768u * 64u);
   if (i >= p.bw * p.bh * p.bz) return;
   uint bx = i % p.bw;
   uint r0 = i / p.bw;
   uint by = r0 % p.bh;
   uint z = r0 / p.bh;
   bool bc1 = p.mode == 0u || p.mode == 3u;
   uint bs = bc1 ? 8u : 16u;
   uint so = (p.src_off + z * p.src_slice + by * p.src_row + bx * bs) >> 2;
   uint dof = p.dst_off + z * p.dst_slice + by * 4u * p.dst_row + bx * 16u;

   uvec2 ab = uvec2(src.d[so], src.d[so + 1u]);                       // alpha half (BC2/BC3)
   uvec2 cb = bc1 ? ab : uvec2(src.d[so + 2u], src.d[so + 3u]);
   uint e0 = cb.x & 0xffffu, e1 = cb.x >> 16;
   uvec3 a = exp565(e0), b = exp565(e1);
   bool four = !bc1 || e0 > e1;
   uvec3 c2 = four ? (a * 2u + b) / 3u : (a + b) / 2u;
   uvec3 c3 = four ? (a + b * 2u) / 3u : uvec3(0u);

   for (uint r = 0u; r < 4u; r++) {
      for (uint c = 0u; c < 4u; c++) {
         uint t = r * 4u + c;
         uint k = (cb.y >> (2u * t)) & 3u;
         uvec3 col = k == 0u ? a : (k == 1u ? b : (k == 2u ? c2 : c3));
         uint al = 255u;
         if (bc1) { if (p.mode == 0u && !four && k == 3u) al = 0u; }
         else if (p.mode == 1u) al = ((src.d[so + (t >> 3)] >> ((t & 7u) * 4u)) & 15u) * 17u;
         else al = bc4u(ab, t);
         dst.d[((dof + r * p.dst_row) >> 2) + c] = col.x | (col.y << 8) | (col.z << 16) | (al << 24);
      }
   }
}
