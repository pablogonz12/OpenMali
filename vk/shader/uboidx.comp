#version 450
// t_compile dyn_index: a UBO array indexed with a runtime value (push constant). The SPIR-V is compiled against layouts whose
// array count differs, so the clamp the descriptor lowering inserts (umin against count - 1) moves; MALI_NIR_DUMP is what the
// test reads. Unity 2023.2 generates exactly this shape for its per-object constant buffer arrays.
layout(local_size_x = 1) in;
layout(push_constant) uniform P { uint i; } pc;
layout(set = 0, binding = 0, std140) uniform U { vec4 c; } ubo[4];
layout(set = 0, binding = 1, std430) buffer O { vec4 o; } outb;
void main() { outb.o = ubo[pc.i].c; }
