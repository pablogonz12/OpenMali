#version 450
//@HEADER@
// R4-M7 BC decode: BC6H (mode bit0: signed) -> RGBA16F linear shadow (alpha = 1.0). One invocation = one 4x4 block.
// Same arithmetic as Mesa's util/format/texcompress_bptc_tmp.h (bitfield table per mode, unquantize, 64-step interpolation, *31/64 finish).
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer S { uint d[]; } src;
layout(set = 0, binding = 1, std430) buffer D { uint d[]; } dst;
layout(push_constant) uniform P {
   uint src_off, src_row, src_slice;
   uint dst_off, dst_row, dst_slice;   // dst row pitch multiple of 32 bytes
   uint bw, bh, bz;
   uint mode;                          // bit0: signed (SFLOAT)
   uint pad0, pad1;
} p;

//@TABLES@

const uint W3[8] = uint[](0u, 9u, 18u, 27u, 37u, 46u, 55u, 64u);
const uint W4[16] = uint[](0u, 4u, 9u, 13u, 17u, 21u, 26u, 30u, 34u, 38u, 43u, 47u, 51u, 55u, 60u, 64u);

uvec4 blk;

uint gb(uint pos, uint n) {
   uint wi = pos >> 5, sh = pos & 31u;
   uint v = blk[wi] >> sh;
   if (sh + n > 32u) v |= blk[min(wi + 1u, 3u)] << (32u - sh);
   return v & ((1u << n) - 1u);
}

int sunq(int v, int n) {
   if (n >= 16) return v;
   if (v == 0) return 0;
   bool neg = v < 0;
   if (neg) v = -v;
   if (v >= (1 << (n - 1)) - 1) v = 0x7fff;
   else v = ((v << 15) + 0x4000) >> (n - 1);
   return neg ? -v : v;
}

int uunq(int v, int n) {
   if (n >= 15) return v;
   if (v == 0) return 0;
   if (v == (1 << n) - 1) return 0xffff;
   return ((v << 15) + 0x4000) >> (n - 1);
}

void main() {
   uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (32768u * 64u);
   if (i >= p.bw * p.bh * p.bz) return;
   uint bx = i % p.bw;
   uint r0 = i / p.bw;
   uint by = r0 % p.bh;
   uint z = r0 / p.bh;
   uint so = (p.src_off + z * p.src_slice + by * p.src_row + bx * 16u) >> 2;
   uint dof = p.dst_off + z * p.dst_slice + by * 4u * p.dst_row + bx * 32u;
   blk = uvec4(src.d[so], src.d[so + 1u], src.d[so + 2u], src.d[so + 3u]);
   bool sg = (p.mode & 1u) != 0u;

   uint b0 = blk.x & 255u, mode, bo;
   if ((b0 & 2u) != 0u) { mode = (((b0 >> 1) & 0xeu) | (b0 & 1u)) + 2u; bo = 5u; }
   else { mode = b0 & 3u; bo = 2u; }
   uint mi = MINFO[mode];

   if ((mi & 1u) != 0u) {                       // reserved mode: (0,0,0,1)
      for (uint r = 0u; r < 4u; r++)
         for (uint c = 0u; c < 4u; c++) {
            uint o = ((dof + r * p.dst_row) >> 2) + c * 2u;
            dst.d[o] = 0u;
            dst.d[o + 1u] = 0x3c000000u;
         }
      return;
   }
   bool trans = (mi & 2u) != 0u;
   uint pbits = (mi >> 2) & 7u;
   int nend = int((mi >> 5) & 31u);
   uint nidx = (mi >> 10) & 7u;
   uint nep = pbits != 0u ? 4u : 2u;

   int ep[12];
   for (uint k = 0u; k < 12u; k++) ep[k] = 0;
   for (uint f = 0u; f < 24u; f++) {
      uint e = MFLD[mode * 24u + f];
      uint nb = (e >> 8) & 15u;
      if (nb == 0u) break;
      uint epi = e & 3u, comp = (e >> 2) & 3u, off = (e >> 4) & 15u;
      uint v = gb(bo, nb);
      bo += nb;
      if (((e >> 12) & 1u) != 0u) {
         uint rv = 0u;
         for (uint k = 0u; k < nb; k++) if (((v >> k) & 1u) != 0u) rv |= 1u << (nb - 1u - k);
         v = rv;
      }
      ep[epi * 3u + comp] |= int(v << off);
   }
   if (trans) {
      for (uint e = 1u; e < nep; e++)
         for (uint c = 0u; c < 3u; c++) {
            int d = bitfieldExtract(ep[e * 3u + c], 0, int((mi >> (13u + 4u * c)) & 15u));
            ep[e * 3u + c] = (ep[c] + d) & ((1 << nend) - 1);
         }
   }
   for (uint k = 0u; k < nep * 3u; k++) {
      if (sg) ep[k] = sunq(bitfieldExtract(ep[k], 0, nend), nend);
      else ep[k] = uunq(ep[k], nend);
   }

   uint part = 0u, subsets = 0u, anc = 0xffu;
   if (pbits != 0u) {
      part = gb(bo, pbits);
      bo += pbits;
      subsets = PART2[part];
      anc = ANCH2[part];
   }

   for (uint t = 0u; t < 16u; t++) {
      bool two = pbits != 0u;
      bool anchor = t == 0u || (two && anc == t);
      uint before = t == 0u ? 0u : 1u + ((two && t > anc) ? 1u : 0u);
      uint ib = nidx - (anchor ? 1u : 0u);
      uint idx = gb(bo + nidx * t - before, ib);
      uint w = nidx == 3u ? W3[idx] : W4[idx];
      uint s = (subsets >> (2u * t)) & 3u;
      uint h[3];
      for (uint c = 0u; c < 3u; c++) {
         int a = ep[s * 6u + c], b = ep[s * 6u + 3u + c];
         int v = ((64 - int(w)) * a + int(w) * b + 32) >> 6;
         if (sg) v = v < 0 ? ((-v * 31 / 32) | 0x8000) : v * 31 / 32;
         else v = v * 31 / 64;
         h[c] = uint(v) & 0xffffu;
      }
      uint o = ((dof + (t >> 2) * p.dst_row) >> 2) + (t & 3u) * 2u;
      dst.d[o] = h[0] | (h[1] << 16);
      dst.d[o + 1u] = h[2] | 0x3c000000u;
   }
}
