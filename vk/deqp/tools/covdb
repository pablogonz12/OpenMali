def cmd_groups(con, args):
    sql = f"""SELECT c.name, c.status FROM \"case\" c JOIN run r ON r.id=c.run_id
              WHERE {scope_clause(args)} ORDER BY c.name, {run_order_sql()}"""
    latest = {}
    for name, st in con.execute(sql):
        latest.setdefault(name, st)
    groups = {}
    for n, st in latest.items():
        groups.setdefault(group_of(n), {}).setdefault(st, 0)
        groups[group_of(n)][st] += 1
    for g in sorted(groups):
        t = groups[g]
        print(f"{sum(t.values()):6d} {g:<52} " + " ".join(f"{k.lower()}={t[k]}" for k in sorted(t)))


def farm_sha_map():
    """driver_sha256 per commit, from the farm's job records (MALI_FARM_STATE/jobs/*.json: so_sha256)."""
    import json
    import glob
    state = os.environ.get("MALI_FARM_STATE") or os.path.join(os.path.expanduser("~"), ".local/state/mali-farm")
    out = {}
    for f in glob.glob(os.path.join(state, "jobs", "*.json")):
        try:
            j = json.load(open(f))
        except (OSError, ValueError):
            continue
        if isinstance(j, dict) and j.get("commit") and j.get("so_sha256"):
            c = str(j["commit"])
            out.setdefault(c[:8], j["so_sha256"])
            out.setdefault(c[:12], j["so_sha256"])
            out.setdefault(c, j["so_sha256"])
    return out


def short_source(path):
    rel = os.path.relpath(os.path.abspath(path), repo_root())
    if rel.startswith(".."):
        return os.path.basename(os.path.dirname(os.path.abspath(path))) + "/" + os.path.basename(path)
    return rel


def git_file_date(path):
    """Commit date of the last commit that touched a tracked file (the file's own date, not the checkout's)."""
    import subprocess
    try:
        rel = os.path.relpath(os.path.abspath(path), repo_root())
    except ValueError:
        return None
    try:
        out = subprocess.run(["git", "-C", repo_root(), "log", "-1", "--format=%ad", "--date=short", "--", rel],
                             capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout.strip() or None


def git_date(commit):
    import subprocess
    for cmd in (["git", "-C", repo_root(), "log", "-1", "--format=%ad", "--date=short", commit],
                ["git", "-C", repo_root(), "show", "-s", "--format=%ad", "--date=short", commit]):
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        except (OSError, subprocess.TimeoutExpired):
            return None
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    return None


