# aarch64 glibc toolchain for dEQP-VK: system clang + the Ubuntu arm64 sysroot of droidtest/tools (same as cross/a64-glibc.ini)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
get_filename_component(_T "${CMAKE_CURRENT_LIST_DIR}/../../../droidtest/tools" ABSOLUTE)
set(CMAKE_SYSROOT ${_T}/sysroot)
file(GLOB _G "${CMAKE_SYSROOT}/usr/lib/gcc/aarch64-linux-gnu/*")
list(SORT _G)
list(GET _G -1 _GCC)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(_F "--gcc-install-dir=${_GCC} -fuse-ld=lld -Qunused-arguments")
set(CMAKE_C_FLAGS_INIT "${_F}")
set(CMAKE_CXX_FLAGS_INIT "${_F} -include cstdint -Wno-error -Wno-missing-template-arg-list-after-template-kw")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -Wl,--allow-shlib-undefined")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
