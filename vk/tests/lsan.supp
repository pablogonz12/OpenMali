# leaks in host tools that inherit the preloaded ASan runtime (MALI_SAN=1), not in the driver.
# Matched by the executable's own frames only: the tools are bash/sed/gcc (cc1 under /usr/lib/gcc). A suppression on libc.so is deliberately absent:
# a driver leak through strdup/fopen/getline has a libc frame in its stack and would be hidden by it.
leak:/usr/bin/bash
leak:/usr/bin/sed
leak:/usr/bin/gcc
leak:/usr/bin/x86_64-linux-gnu-gcc
leak:/usr/bin/as
leak:/usr/bin/x86_64-linux-gnu-as
leak:/usr/bin/ld
leak:/usr/bin/x86_64-linux-gnu-ld
leak:/usr/lib/gcc/
