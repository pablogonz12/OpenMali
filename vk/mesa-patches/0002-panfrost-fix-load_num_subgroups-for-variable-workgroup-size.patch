From 555d65ac9abfbb5aa9b59fcce7d0759eec4e3d9b Mon Sep 17 00:00:00 2001
From: jiajia Qian
Date: Thu, 22 Oct 2026 16:45:36 +0800
Subject: [PATCH] panfrost: fix load_num_subgroups for variable workgroup size

Use nir_load_workgroup_size() at runtime instead of relying on a
compile-time workgroup size.

The previous code only worked for kernels with a fixed
reqd_work_group_size. Fix clGetKernelSubGroupInfo() and
get_num_sub_groups() returning 0 when the local size is provided at
kernel launch time.

Assisted-by: LLM
Signed-off-by: jiajia Qian
Reviewed-by: Faith Ekstrand
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45477>
---
 src/panfrost/compiler/bifrost/bifrost_nir.c | 27 +++++++++++++++------
 1 file changed, 19 insertions(+), 8 deletions(-)

diff --git a/src/panfrost/compiler/bifrost/bifrost_nir.c b/src/panfrost/compiler/bifrost/bifrost_nir.c
index b4a42f282c8f..4546eede6ad0 100644
--- a/src/panfrost/compiler/bifrost/bifrost_nir.c
+++ b/src/panfrost/compiler/bifrost/bifrost_nir.c
@@ -484,14 +484,25 @@ bi_lower_subgroups(nir_builder *b, nir_intrinsic_instr *intr, void *data)
       break;
 
    case nir_intrinsic_load_num_subgroups: {
-      uint32_t subgroup_size = pan_subgroup_size(arch);
-      assert(!b->shader->info.workgroup_size_variable);
-      uint32_t workgroup_size =
-         b->shader->info.workgroup_size[0] *
-         b->shader->info.workgroup_size[1] *
-         b->shader->info.workgroup_size[2];
-      uint32_t num_subgroups = DIV_ROUND_UP(workgroup_size, subgroup_size);
-      val = nir_imm_int(b, num_subgroups);
+      unsigned subgroup_size = pan_subgroup_size(arch);
+      nir_def *local_size = nir_load_workgroup_size(b);
+      /* workgroup_size.x * workgroup_size.y * workgroup_size.z */
+      nir_def *workgroup_size =
+         nir_imul(b,
+            nir_imul(b,
+               nir_channel(b, local_size, 0),
+               nir_channel(b, local_size, 1)),
+            nir_channel(b, local_size, 2));
+      /*
+       * DIV_ROUND_UP(workgroup_size, subgroup_size). subgroup_size is a power
+       * of two, so nir_udiv_imm lowers the division to a right shift. Using the
+       * runtime workgroup size (like load_subgroup_id above) keeps this correct
+       * for kernels with a variable local size.
+       */
+      nir_def *num_subgroups =
+         nir_udiv_imm(b, nir_iadd_imm(b, workgroup_size, subgroup_size - 1),
+                      subgroup_size);
+      val = num_subgroups;
       break;
    }
 
