#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""inspect-session: which GPU driver does each process of a running DroidDeck /
MediaDeck guest session really use, and how fast does it render?

Needs droiddeckctl: default path ~/Projects/mali-gaming/tools/droiddeckctl, override with
DROIDDECKCTL=<path>. If it is missing or the state query fails the output says "state unavailable"
(exit 1), which is not the same as "no session".

Read-only: no lock, never starts or stops a session, never changes prefs/env.
It only calls the read subcommands of droiddeckctl (state, env list, guest,
cdp eval, pacing) and reads sysfs over adb.

  tools/inspect-session --serial <ip:port>
  tools/inspect-session --serial <ip:port> --json
  tools/inspect-session --serial <ip:port> --watch 5

Verdict per process, from /proc/<pid>/maps and environ inside the guest:
  OURS      libvulkan_mali* mapped (our driver)
  BRIDGE    libvulkan_droidbridge.so mapped (the Android bridge)
  SOFTWARE  lvp / llvmpipe / swrast, or Mesa gallium + libLLVM with no Vulkan ICD
  NONE      no Vulkan ICD or GL driver mapped (or maps unreadable)
"Mapped" is not "used": a process can map two ICDs. The verdict follows the
first match in the order SOFTWARE-by-env, OURS, BRIDGE, SOFTWARE-by-maps.
"""
import argparse
import json
import math
import os
import re
import subprocess
import sys
import time

DEFAULT_CTL = os.path.expanduser("~/Projects/mali-gaming/tools/droiddeckctl")
DEFAULT_PACKAGE = "com.ludashi.benchmark"
ENV_RE = r"^(BL_|MALI_|VK_|LIBGL|GALLIUM|MESA_|ZINK_)"
DEVFREQ = "/sys/class/misc/mali0/device/devfreq"

# Runs inside the guest as root; prints one JSON list. Read-only.
GUEST_SCRIPT = r'''
import json, os, re
LIB = re.compile(r"(vulkan|libGL|libEGL|gallium|LLVM|lvp|swrast|mali|droidbridge|_dri\.so)")
ENV = re.compile(r"%s")
def rd(p):
    try:
        with open(p, "rb") as f:
            return f.read()
    except Exception:
        return None
procs = {}
for d in os.listdir("/proc"):
    if not d.isdigit():
        continue
    raw = rd("/proc/%%s/cmdline" %% d)
    st = rd("/proc/%%s/stat" %% d)
    if not raw or not st:
        continue
    args = raw.decode("utf-8", "replace").split("\0")
    ppid = int(st.decode("utf-8", "replace").rsplit(")", 1)[1].split()[1])
    procs[int(d)] = (ppid, args)
def under_reaper(pid):
    seen = 0
    while pid in procs and seen < 64:
        ppid, args = procs[pid]
        if os.path.basename(args[0]) == "reaper" and "SteamLaunch" in args:
            return pid != 0
        pid = ppid
        seen += 1
    return False
out = []
for pid, (ppid, args) in sorted(procs.items()):
    exe = os.path.basename(args[0])
    role = None
    if exe == "gamescope":
        role = "gamescope"
    elif exe == "Xwayland":
        role = "xwayland" + (" " + args[1] if len(args) > 1 else "")
    elif exe == "steam" and "steamrtarm64" in args[0]:
        role = "steam"
    elif exe == "steamwebhelper":
        t = [a for a in args if a.startswith("--type=")]
        role = "webhelper " + (t[0][7:] if t else "browser")
        if any(a.startswith("--utility-sub-type=") for a in args):
            role += ":" + [a for a in args if a.startswith("--utility-sub-type=")][0].split(".")[-1]
    elif exe == "reaper":
        continue
    elif under_reaper(pid):
        role = "game " + exe
    if role is None:
        continue
    maps = rd("/proc/%%d/maps" %% pid)
    libs, dmabuf = set(), False
    if maps is not None:
        for line in maps.decode("utf-8", "replace").splitlines():
            parts = line.split(None, 5)
            if len(parts) < 6:
                continue
            path = parts[5]
            if path.endswith(" (deleted)"):
                path = path[:-len(" (deleted)")]
            if path.startswith("/dmabuf") and "mali" in path:
                dmabuf = True
            elif path.startswith("/") and LIB.search(os.path.basename(path)):
                libs.add(os.path.basename(path))
    env = {}
    e = rd("/proc/%%d/environ" %% pid)
    if e:
        for kv in e.decode("utf-8", "replace").split("\0"):
            k, _, v = kv.partition("=")
            if ENV.match(k):
                env[k] = v[:160]
    out.append({"pid": pid, "role": role, "maps_readable": maps is not None,
                "libs": sorted(libs), "mali_dmabuf": dmabuf, "env": env})
print(json.dumps(out))
''' % ENV_RE.replace("%", "%%")


def run_ctl(args, serial, timeout=60):
    """Run droiddeckctl; return (json_or_None, error_text)."""
    env = dict(os.environ)
    env.setdefault("DROIDDECK_PACKAGE", DEFAULT_PACKAGE)
    ctl = env.get("DROIDDECKCTL", DEFAULT_CTL)
    env["PYTHONPATH"] = os.path.dirname(ctl) + os.pathsep + env.get("PYTHONPATH", "")
    cmd = [sys.executable, "-I", ctl]
    if serial:
        cmd += ["--serial", serial]
    try:
        p = subprocess.run(cmd + args, capture_output=True, text=True,
                           timeout=timeout, env=env, check=False)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, "%s: %s" % (type(e).__name__, e)
    text = "\n".join(l for l in p.stdout.splitlines() if not l.startswith("Resolved ADB"))
    try:
        return json.loads(text), ""
    except ValueError:
        return None, (p.stderr or p.stdout).strip()[-300:] or "no output (exit %d)" % p.returncode


def adb_cat(serial, path):
    if not serial:
        return None
    try:
        p = subprocess.run(["adb", "-s", serial, "shell", "cat", path],
                           capture_output=True, text=True, timeout=15, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0 or "denied" in p.stdout or "No such" in p.stdout:
        return None
    return p.stdout.strip() or None


def verdict(proc):
    libs, env = proc["libs"], proc["env"]
    vk = ("OURS" if any(l.startswith("libvulkan_mali") for l in libs)
          else "BRIDGE" if "libvulkan_droidbridge.so" in libs
          else "SOFTWARE" if any("lvp" in l for l in libs) else None)
    gallium = any("gallium" in l or "libGLX_mesa" in l for l in libs)
    llvm = any("libLLVM" in l for l in libs)
    swrast = any("swrast" in l for l in libs)
    drv = env.get("GALLIUM_DRIVER", "")
    sw_env = (drv in ("llvmpipe", "softpipe", "swrast")
              or env.get("LIBGL_ALWAYS_SOFTWARE") == "1")
    if sw_env:
        v = "SOFTWARE"
    elif vk in ("OURS", "BRIDGE"):
        v = vk
    elif vk == "SOFTWARE" or swrast or (gallium and llvm):
        v = "SOFTWARE"
    else:
        v = "NONE"
    if not proc["maps_readable"]:
        v = "NONE"
    gl = ("zink" if drv == "zink" else drv or ("mesa" if gallium else "-"))
    icd = {"OURS": "mali", "BRIDGE": "bridge", "SOFTWARE": "lvp" if vk == "SOFTWARE" else "-",
           None: "-"}[vk]
    return v, icd, gl


def collect(serial):
    r = {"time": time.strftime("%H:%M:%S"), "serial": serial}
    st, err = run_ctl(["state"], serial)
    sess = (st or {}).get("session") or {}
    if not st:
        # the query itself failed: say so, do not claim there is no session
        r["state"] = {"running": None, "unavailable": True, "error": err or "state query failed"}
        return r
    if not sess.get("running"):
        r["state"] = {"running": False, "error": None, "phase": sess.get("phase")}
        return r
    r["state"] = {k: sess.get(k) for k in ("id", "mode", "phase", "program", "refreshHz",
                                           "output", "suspended")}
    r["state"]["running"] = True
    r["state"]["build"] = st.get("build")
    # --serial omitted: droiddeckctl picked the device; use its serial for the adb reads
    serial = serial or st.get("deviceSerial")
    r["serial"] = serial
    en, _ = run_ctl(["env", "list"], serial)
    r["env"] = {k: (en or {}).get(k) for k in ("active", "pending", "persistent")}
    g, err = run_ctl(["guest", "--timeout", "30", "--", "python3", "-c", GUEST_SCRIPT], serial, 60)
    procs = []
    if g and g.get("ok") and g.get("exitCode", 0) == 0:
        try:
            procs = json.loads(g["stdout"]["text"])
        except (ValueError, KeyError):
            err = "guest output not JSON"
    else:
        err = err or "guest command failed: %s" % ((g or {}).get("stderr") or {}).get("text", "")[:200]
    for p in procs:
        p["verdict"], p["vk_icd"], p["gl"] = verdict(p)
    r["procs"] = procs
    if err:
        r["procs_error"] = err
    gp = next((p for p in procs if p["role"] == "gamescope"), None)
    r["gpu_env"] = (gp or {}).get("env", {})
    cdp, cerr = run_ctl(["cdp", "eval", "--target", "MainMenu",
                         'var g=document.createElement("canvas").getContext("webgl");'
                         'var e=g&&g.getExtension("WEBGL_debug_renderer_info");'
                         'e?g.getParameter(e.UNMASKED_RENDERER_WEBGL):"no webgl"'], serial)
    r["steam_renderer"] = (cdp or {}).get("value") if cdp and cdp.get("ok") else None
    if r["steam_renderer"] in (None, "no webgl"):
        # MainMenu popup not loaded yet (or no WebGL there): try the default target
        cdp2, cerr2 = run_ctl(["cdp", "eval", 'var g=document.createElement("canvas").getContext("webgl");'
                               'var e=g&&g.getExtension("WEBGL_debug_renderer_info");'
                               'e?g.getParameter(e.UNMASKED_RENDERER_WEBGL):"no webgl"'], serial)
        if cdp2 and cdp2.get("ok") and cdp2.get("value") != "no webgl":
            r["steam_renderer"], cerr = cdp2["value"], ""
        elif r["steam_renderer"] is None:
            cerr = cerr or cerr2
    if r["steam_renderer"] is None:
        r["steam_renderer_error"] = cerr or "cdp not ok"
    pc, perr = run_ctl(["pacing", "--seconds", "2"], serial)
    if pc and pc.get("ok"):
        pr = pc.get("presentToPresentMs") or {}
        worst = max((int(k) for k in pr), default=None)
        r["pacing"] = {"fpsOnScreen": pc.get("fpsOnScreen"), "frames": pc.get("frames"),
                       "cadenceMs": pc.get("cadenceMs"),
                       "offCadencePercent": pc.get("offCadencePercent"),
                       "worstIntervalMs": worst}
    else:
        r["pacing"] = None
        r["pacing_error"] = perr or "pacing not ok"
    gpu = {}
    for key, f in (("cur_freq", "cur_freq"), ("max_freq", "max_freq")):
        v = None
        for d in ("48000000.mali",):
            v = adb_cat(serial, "%s/%s/%s" % (DEVFREQ, d, f))
        gpu[key] = v
    busy = adb_cat(serial, "/sys/kernel/ged/hal/gpu_utilization")
    gpu["busy"] = busy
    r["gpu"] = gpu
    return r


def clean(text):
    """Guest and device strings are untrusted: drop control characters (ANSI escapes) before printing."""
    return "".join(c if c.isprintable() else "?" for c in str(text))


def render(r):
    L = ["== inspect-session %s  %s ==" % (r["serial"], r["time"])]
    s = r["state"]
    if s.get("unavailable"):
        L.append("state unavailable: %s" % s["error"])
        return "\n".join(L)
    if not s.get("running"):
        L.append("no session (phase=%s)%s" % (s.get("phase"), "  [%s]" % s["error"] if s.get("error") else ""))
        return "\n".join(L)
    L.append("session %s  mode=%s phase=%s program=%s %sHz out=%s%s" % (
        s["id"], s["mode"], s["phase"], s["program"], s["refreshHz"],
        "x".join(map(str, s["output"] or [])), " SUSPENDED" if s["suspended"] else ""))
    e = r["env"]
    L.append("env active=%s pending=%s" % (e["active"] or "-", e["pending"] or "-"))
    if r["gpu_env"]:
        L.append("gamescope env: " + " ".join("%s=%s" % kv for kv in sorted(r["gpu_env"].items())
                                                if not kv[0].startswith(("BL_FEX", "BL_STEAM_", "BL_LAUNCH", "BL_ANDROID", "BL_DEBUG", "BL_LOG"))
                                                and len(kv[1]) < 90))
    L.append("")
    L.append("%-7s %-26s %-9s %-7s %-7s %s" % ("PID", "ROLE", "VERDICT", "VK-ICD", "GL", "LIBS"))
    for p in r["procs"]:
        short = ",".join(re.sub(r"\.so.*", "", l) for l in p["libs"]
                         if any(k in l for k in ("vulkan_", "lvp", "gallium", "LLVM", "swrast")))
        L.append("%-7d %-26s %-9s %-7s %-7s %s" % (p["pid"], p["role"][:26], p["verdict"],
                                                    p["vk_icd"], p["gl"], short))
    if r.get("procs_error"):
        L.append("procs: " + r["procs_error"])
    L.append("")
    L.append("steam renderer (cdp): %s" % (r["steam_renderer"] or "n/a (%s)" % r.get("steam_renderer_error")))
    pc = r["pacing"]
    L.append("on-screen: %s" % ("%s fps (%s frames, cadence %s ms, off-cadence %s%%, worst gap %s ms)" % (
        pc["fpsOnScreen"], pc["frames"], pc["cadenceMs"], pc["offCadencePercent"], pc["worstIntervalMs"])
        if pc else "n/a (%s)" % r.get("pacing_error")))
    g = r["gpu"]
    L.append("gpu: freq=%s max=%s busy=%s" % (g["cur_freq"] or "n/a", g["max_freq"] or "n/a",
                                              g["busy"] or "n/a") + ("" if g["cur_freq"] or g["busy"] else "  (denied from adb)"))
    return "\n".join(L)


def clean_lines(text):
    return "\n".join(clean(l) for l in text.split("\n"))


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--serial", help="adb serial, e.g. <ip:port>")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--watch", type=float, metavar="N", help="repeat every N seconds")
    a = ap.parse_args()
    if a.watch is not None and not (math.isfinite(a.watch) and a.watch > 0):
        ap.error("--watch needs a finite interval greater than 0")
    while True:
        r = collect(a.serial)
        r["serial"] = r["serial"] or "(auto)"
        print(json.dumps(r, indent=2) if a.json else clean_lines(render(r)), flush=True)
        if not a.watch:
            return 1 if r["state"].get("unavailable") else 0
        print()
        time.sleep(a.watch)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
