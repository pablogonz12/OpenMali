def cmd_results(a):
    j = L.find_job(a.job)
    if j["suite"] == "cases" and not getattr(a, "json", False):
        print(f"{j['id']} {j['ref']} {j['commit'][:7]} cases x{j.get('repeat')}: {L.job_verdict(j)}")
        for c in j["parts"]:
            p = L.run_path(j["id"], c)
            run = L.read_json(p) if os.path.exists(p) else {}
            for case, cnt in (run.get("case_counts") or {}).items():
                tot = sum(cnt.values())
                print(f"  {c} {run.get('device')}: {case[-70:]}: " + ", ".join(f"{k} {s}" for s, k in sorted(cnt.items())) + f" of {tot} ({100 * cnt.get('Pass', 0) // max(tot, 1)}% pass)")
            if not run.get("case_counts"):
                print(f"  {c}: {run.get('verdict') or j['parts'][c]['state']} {run.get('notes', '')[:100]}")
        return
    out = {"job": j, "verdict": L.job_verdict(j), "runs": {}}
    for c in j["parts"]:
        p = L.run_path(j["id"], c)
        if os.path.exists(p):
            out["runs"][c] = L.read_json(p)
    print(json.dumps(out, indent=1, sort_keys=True))


# ---------------------------------------------------------------- cheap commands (one short command instead of ad-hoc scripts)
CAP = 5


def job_tsv(j, cls):
    """result tsv of a finished daily part -> {case: status} | None"""
    p = j["parts"].get(cls) or {}
    f = os.path.join(L.state_dir(), "logs", f"{j['id']}-{p.get('device')}-daily.tsv")
    return L.read_tsv(f) if p.get("device") and os.path.exists(f) else None


def names(cs, cap=CAP):
    cs = sorted(cs)
    short = lambda c: c.replace("dEQP-VK.", "")[-58:]
    return ", ".join(short(c) for c in cs[:cap]) + (f" (+{len(cs) - cap} more)" if len(cs) > cap else "")


def finished(j, cls):
    p = j["parts"].get(cls) or {}
    return p.get("state") == "done" and p.get("verdict")


def cmd_cancel(a):
    os.makedirs(os.path.join(L.state_dir(), "cancel"), exist_ok=True)
    for jid in a.job:
        try:
            j = L.find_job(jid)
        except (SystemExit, Exception):
            print(f"{jid}: no such job")
            continue
        out = []
        for c, p in j["parts"].items():
            if p["state"] == "pending":
                p["state"] = "cancelled"
                out.append(f"{c} cancelled")
            elif p["state"] == "running":
                if a.running:
                    open(os.path.join(L.state_dir(), "cancel", j["id"]), "w").close()      # farmd stops it within one poll and releases the lock
                    out.append(f"{c} stop requested")
                else:
                    out.append(f"{c} RUNNING (use --running)")
            else:
                out.append(f"{c} {p.get('verdict') or p['state']} (untouched)")
        L.write_json(L.job_path(j["id"]), j)
        print(f"{j['id']}: " + ", ".join(out))


def counts_str(run):
    c = run.get("counts") or {}
    if "Pass" in c or "Fail" in c:
        return f"{c.get('Pass', 0)}/{c.get('Fail', 0)}/{c.get('NotSupported', 0)}"
    return f"{c.get('tests', 0) - c.get('failed', 0)}/{c.get('tests', 0)} tests"


def cmd_bench(a):
    if a.what != "publish":
        raise SystemExit("farm bench: publish")
    remote = os.environ.get("MALI_FARM_PUBLISH_REMOTE") or git("remote", "get-url", "origin")
    res = BL.publish(L.state_dir(), remote, log=lambda m: print(m, file=sys.stderr))
    print(f"bench publish: {res['status']} ({res['n']} rows) {res['msg']}")
    if res["status"] == "error":
        raise SystemExit(1)


def cmd_digest(a):
    _, devs = L.load_devices()
    print_devices(devs)
    jobs = L.list_jobs()
    st = {}
    run_now = []
    for j in jobs:
        for c, p in j["parts"].items():
            st[p["state"]] = st.get(p["state"], 0) + 1
            if p["state"] == "running":
                run_now.append(f"{j['id']}/{c} ({j['ref']} {j['suite']}) on {p.get('device')}")
    print("queue: " + ", ".join(f"{n} {k}" for k, n in sorted(st.items())) + ("; running " + "; ".join(run_now) if run_now else ""))
    classes = sorted({d["class"] for d in devs.values()})
    def latest(ref, suite, cls):
        for j in reversed(jobs):
            if j["ref"] == ref and j["suite"] == suite and finished(j, cls):
                return j
    mains = {c: latest("main", "daily", c) for c in classes}
    refs = []
    for j in reversed(jobs):
        if j["ref"] not in refs:
            refs.append(j["ref"])
    lines = []
    for ref in refs:
        for cls in classes:
            sm, dl = latest(ref, "smoke", cls), latest(ref, "daily", cls)
            if not (sm or dl):
                continue
            seg = []
            for tag, j in (("smoke", sm), ("daily", dl)):
                if j:
                    run = L.read_json(L.run_path(j["id"], cls)) if os.path.exists(L.run_path(j["id"], cls)) else {}
                    seg.append(f"{tag} {j['parts'][cls]['verdict']} {counts_str(run)} [{j['id'][9:15]}-{j['commit'][:7]}]")
            lines.append(f"{ref[:22]:22} {cls:4} " + " | ".join(seg))
            m = mains.get(cls)
            if dl and m and ref != "main":
                a1, b1 = job_tsv(m, cls), job_tsv(dl, cls)
                if a1 and b1:
                    worse = [c for c, s in a1.items() if s == "Pass" and b1.get(c, "Missing") != "Pass"]
                    ns = [c for c in worse if b1.get(c) == "NotSupported"]
                    if worse:
                        lines.append(f"    vs main {m['commit'][:7]}: {len(worse)} regressed ({len(ns)} ->NS): {names(worse)}")
    bl = BL.digest_lines(BL.load_rows(L.state_dir()))          # latest bench per phone always shown (not cut by the room limit)
    room = 40 - 4 - len(devs) - len(bl)
    print("\n".join(bl + lines[:room]) + (f"\n... {len(lines) - room} more lines (older refs)" if len(lines) > room else ""))


def cmd_diff(a):
    ja, jb = L.find_job(a.a), L.find_job(a.b)
    out = []
    for cls in sorted(set(ja["parts"]) & set(jb["parts"])):
        if a.cls and cls != a.cls:
            continue
        x, y = job_tsv(ja, cls), job_tsv(jb, cls)
        if x is None or y is None:
            out.append(f"{cls}: no result tsv for {'A' if x is None else 'B'}")
            continue
        grp = {}
        for c in sorted(set(x) | set(y)):
            sa, sb = x.get(c, "absent"), y.get(c, "absent")
            if sa != sb:
                grp.setdefault(f"{sa}->{sb}", []).append(c)
        out.append(f"{cls}: {ja['id']} ({ja['ref']}) -> {jb['id']} ({jb['ref']}): {sum(map(len, grp.values()))} changed")
        for k, cs in sorted(grp.items(), key=lambda kv: -len(kv[1])):
            out.append(f"  {k:24} {len(cs):4}  {names(cs, 3)}")
    print("\n".join(out[:40]) if out else "no common class")


def cmd_case(a):
    import re
    rows = []
    for f in sorted(os.listdir(os.path.join(L.state_dir(), "logs"))):
        m = re.match(r"^(\d{8}-\d{6}-[0-9a-f]{8}(?:-\d+)?)-(.+)-daily\.tsv$", f)
        if not m:
            continue
        try:
            j = L.find_job(m.group(1))
        except (SystemExit, Exception):
            j = {"ref": "?", "commit": "?" * 8, "created": m.group(1)}
        for l in open(os.path.join(L.state_dir(), "logs", f)):
            p = l.rstrip("\n").split("\t")
            if len(p) >= 2 and a.substring in p[0]:
                rows.append((j.get("created", ""), j.get("seq", 0), j["ref"], j["commit"][:7], m.group(2), p[1], p[0]))
    rows.sort()
    multi = len({r[6] for r in rows}) > 1
    cap = 40
    if len(rows) > cap:
        print(f"... {len(rows) - cap} older rows omitted")
    for r in rows[-cap:]:
        print(f"{r[0][:16]} {r[2][:20]:20} {r[3]} {r[4]:8} {r[5]}" + (f"  {r[6][-60:]}" if multi else ""))
    if not rows:
        print("no stored daily log has a case matching that")


def parse_since(v):
    import datetime as dt
    now = dt.datetime.now().astimezone()
    if not v or v == "today":
        return now.replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
    m = re.fullmatch(r"(\d+)([hd])", v)
    if m:
        return time.time() - int(m.group(1)) * (3600 if m.group(2) == "h" else 86400)
    return dt.datetime.fromisoformat(v).astimezone().timestamp()


def util_data(since, now, devs, jobs):
    """per phone: seconds per category in [start, now] from the farm's own records (runs/*.json, jobs, alerts GATE lines, sweep chunks)"""
    import datetime as dt
    ts = lambda s: dt.datetime.fromisoformat(s).timestamp()
    sd = L.state_dir()
    runs = [L.read_json(os.path.join(sd, "runs", f)) for f in os.listdir(os.path.join(sd, "runs")) if f.endswith(".json")]
    jobs_by = {j["id"]: j for j in jobs}
    ev = {}                                                       # alias -> [(t, state)]
    try:
        for l in open(os.path.join(sd, "alerts.log")):
            m = re.match(r"(\S+) GATE (\S+) (\S+)->(\S+)", l)
            if m:
                ev.setdefault(m.group(2), []).append((ts(m.group(1)), m.group(4)))
    except OSError:
        pass
    busy, builds, sweep, demand = {}, {}, {}, {}
    firsts = [since]
    for r in runs:
        if not r.get("started") or not r.get("device"):
            continue
        s = ts(r["started"])
        if s + (r.get("wall_s") or 0) < since:
            continue
        b = jobs_by.get(r["job"], {}).get("build_s") or 0
        busy.setdefault(r["device"], []).append((s, s + r["wall_s"]))
        builds.setdefault(r["device"], []).append((s, min(s + b, s + r["wall_s"])))
        firsts.append(s)
        j = jobs_by.get(r["job"])
        if j:
            demand.setdefault(r["class"], []).append((ts(j["created"]), s))
    for al in devs:
        p = os.path.join(sd, "sweep", devs[al]["class"] + "-chunks.jsonl")
        if os.path.exists(p):
            for l in open(p):
                c = json.loads(l)
                if c.get("dev") == al and ts(c["t"]) >= since:
                    sweep.setdefault(al, []).append((ts(c["t"]) - c.get("wall_s", 0), ts(c["t"])))
    for j in jobs:
        for cls, p in j["parts"].items():
            if p["state"] == "pending":
                demand.setdefault(cls, []).append((ts(j["created"]), now))
    start = min(firsts[1:] or [since])
    start = max(since, start)
    return start, busy, builds, sweep, demand, ev


def cmd_util(a):
    now = time.time()
    _, devs = L.load_devices()
    jobs = L.list_jobs()
    since = parse_since(a.since)
    start, busy, builds, sweep, demand, ev = util_data(since, now, devs, jobs)
    n = max(int(now - start), 1)
    print(f"util since {time.strftime('%m-%d %H:%M', time.localtime(start))} ({n // 3600}h{n % 3600 // 60:02d}m window; busy = a job part holds the phone, build = its driver build under the lock)")
    for al, d in devs.items():
        cat = bytearray(n)                                    # 0 no work, 1 queue gap, 2.. gate states, 250 sweep, 251 busy
        names = {}
        fill = lambda iv, code: [cat.__setitem__(slice(max(int(x - start), 0), max(min(int(y - start), n), 0)), bytes([code]) * max(min(int(y - start), n) - max(int(x - start), 0), 0)) for x, y in iv]
        fill(demand.get(d["class"], []), 1)
        evs = ev.get(d["lock"], ev.get(al, []))
        for i, (t, st) in enumerate(evs):
            if st != "ok":
                names.setdefault(st, 2 + len(names))
                fill([(t, evs[i + 1][0] if i + 1 < len(evs) else now)], names[st])
        fill(sweep.get(al, []), 250)
        fill(busy.get(al, []), 251)
        pct = lambda k: 100 * sum(1 for c in cat if c == k) / n
        tot_busy = pct(251)
        bs = sum(max(y - x, 0) for x, y in builds.get(al, [])) / n * 100
        idle = [("no work queued", pct(0)), ("queue gap (build/poll/other class/lock held by a worker)", pct(1))] + [(f"gated: {st}", pct(code)) for st, code in names.items()]
        idle = sorted(((p, k) for k, p in idle if p >= 0.5), reverse=True)
        print(f"{al:9} {d['class']:4} busy {tot_busy:4.0f}% (build {bs:.0f}%) sweep {pct(250):.0f}% | idle: " + ", ".join(f"{k} {p:.0f}%" for p, k in idle[:4]))
    temps = [l for l in open(os.path.join(L.state_dir(), "logs", "temps-poco-x4.log"))][-1:] if os.path.exists(os.path.join(L.state_dir(), "logs", "temps-poco-x4.log")) else []
    if temps:
        print("last shell-route chunk temps: " + temps[0].strip()[-90:])


def cmd_sweep(a):
    import sweeplib as S
    _, devs = L.load_devices()
    classes = sorted({d["class"] for d in devs.values()})
    off = os.path.join(L.state_dir(), "sweep", "off")
    if a.what in ("on", "off"):
        os.makedirs(os.path.dirname(off), exist_ok=True)
        if a.what == "off":
            open(off, "w").close()
        elif os.path.exists(off):
            os.unlink(off)
        print(f"idle sweep {a.what}")
        return
    if a.what == "failures":
        if not a.cls:
            raise SystemExit("farm: sweep failures needs --class <class>")
        rows, cap = S.fails(a.cls, a.group or "")
        for r in rows[:cap]:
            print(f"{S.NAME.get(r[1], r[1]):8} {r[0]}")
        print(f"({len(rows)} matching non-Pass/non-NS case(s) in the current pass of {a.cls}" + (f"; first {cap} shown)" if len(rows) > cap else ")"))
        return
    print(f"idle sweep {'OFF' if os.path.exists(off) else 'on'}; list = full dEQP-VK mustpass")
    for cls in classes:
        st = S.load(cls)
        if not st.get("n"):
            print(f"{cls}: not started")
            continue
        c = st["counts"]
        eta = ""
        p = os.path.join(S.sdir(), cls + "-chunks.jsonl")
        if os.path.exists(p):
            ls = [json.loads(l) for l in open(p).readlines()[-20:]]
            sec, k = sum(x.get("wall_s", 0) for x in ls), sum(x["n"] for x in ls)
            if sec and k:
                eta = f", ~{(st['n'] - st['pos']) / (k / sec) / 3600:.0f}h left at {k / sec:.1f} cases/s"
        print(f"{cls}: {100 * st['pos'] / st['n']:.1f}% of {st['n']} on {st['commit'][:7]} (since {st['started'][5:16]}{eta}); "
              + " ".join(f"{S.NAME[k]} {c.get(k, 0)}" for k in "PFNCTK" if c.get(k)) + (f"; {len(st['passes'])} pass(es) done" if st["passes"] else ""))
        for g, n, tot in S.top_groups(cls, 3):
            print(f"    {g}: {n} of {tot} not Pass/NS")


def cmd_log(a):
    import glob, gzip, re as _re
    j = L.find_job(a.job)
    fs = sorted(glob.glob(os.path.join(L.state_dir(), "logs", j["id"] + "-*-smoke.log*")))
    if a.cls:
        fs = [x for x in fs if f"-{a.cls}-smoke" in x]
    if not fs:
        raise SystemExit(f"farm: no kept test output for {j['id']}" + (f" class {a.cls}" if a.cls else "") + " (smoke jobs run since this feature only)")
    for p in fs:
        lines = (gzip.open(p, "rt") if p.endswith(".gz") else open(p)).read().splitlines()
        if a.grep:
            lines = [x for x in lines if _re.search(a.grep, x)]
        print(f"== {os.path.basename(p)} ({len(lines)} line(s){', last ' + str(a.tail) if len(lines) > a.tail else ''})")
        print("\n".join(lines[-a.tail:]))


def cmd_bless(a):
    """write the job's per-class daily result tsv over the committed baselines (vk/deqp/ours-daily-sample-<baseline>.tsv) in a checkout"""
    cfg, devs = L.load_devices()
    j = L.find_job(a.job)
    why = []
    main = git("rev-parse", "--verify", "main^{commit}")
    if j["commit"] != main:
        why.append(f"job commit {j['commit'][:8]} is not main's current commit {main[:8]}")
    if j.get("dirty"):
        why.append("job was run on a dirty tree")
    if j["suite"] != "daily":
        why.append(f"suite is {j['suite']}, not the full daily")
    if L.job_verdict(j) != "pass":
        why.append(f"verdict is {L.job_verdict(j)}, not pass")
    files = {}
    for c, p in j["parts"].items():
        run = L.read_json(L.run_path(j["id"], c)) if os.path.exists(L.run_path(j["id"], c)) else {}
        if run.get("verdict") != "pass" or p.get("state") != "done":
            why.append(f"part {c} not a finished pass")
        if not run.get("so_sha256") or run.get("so_sha256") != j.get("so_sha256"):
            why.append(f"part {c}: so_sha256 integrity not confirmed")
        d = devs.get(run.get("device") or p.get("device"))
        src = os.path.join(L.state_dir(), "logs", f"{j['id']}-{run.get('device') or p.get('device')}-daily.tsv")
        if not d or not os.path.exists(src):
            why.append(f"part {c}: no result tsv ({os.path.basename(src)})")
            continue
        n = len(L.read_tsv(src))
        if n != SUITE_CASES:
            why.append(f"part {c}: {n} cases, expected {SUITE_CASES} (full daily)")
        files[d["baseline"]] = src
    if why:
        print("farm bless: refused:\n  " + "\n  ".join(why), file=sys.stderr)
        return 2
    co = os.path.abspath(a.checkout)
    for b, src in sorted(files.items()):
        dst = os.path.join(co, "vk", "deqp", f"ours-daily-sample-{b}.tsv")
        if not os.path.isdir(os.path.dirname(dst)):
            raise SystemExit(f"farm bless: {dst} not in a checkout")
        lines = open(src).read().splitlines(keepends=True)          # same format as the baselines: case<TAB>status<TAB>
        if len(lines) != SUITE_CASES or any(l.count("\t") != 2 or not l.endswith("\t\n") for l in lines):
            raise SystemExit(f"farm bless: {src} is not in baseline format")
        open(dst, "w").writelines(lines)
        print(f"blessed {dst}: {len(lines)} lines, {sum(1 for x in lines if x.split(chr(9))[1] == 'Pass')} Pass")


def main():
    ap = argparse.ArgumentParser(prog="farm")
    sp = ap.add_subparsers(dest="cmd", required=True)
    s = sp.add_parser("submit")
    s.add_argument("ref")
    s.add_argument("--suite", choices=L.SUITES, default="smoke")
    s.add_argument("--need", default="", help="comma list of device classes (default: every configured class)")
    s.add_argument("--env", default="", help='e.g. "MALI_HF=330 FOO=1"')
    s.add_argument("--only", default="", help="(--suite smoke) comma list of test cases passed to the test binaries as --only (draw: triangle two depth ...; compute/meta: buf fill img ...)")
    s.add_argument("--case", action="append", default=[], help="(--suite cases) a dEQP case to run; repeatable")
    s.add_argument("--repeat", type=int, default=1, help="(--suite cases) repetitions of the case list")
    s.set_defaults(f=cmd_submit)
    s = sp.add_parser("status")
    s.add_argument("--all", action="store_true")
    s.set_defaults(f=cmd_status)
    s = sp.add_parser("disable", help="owner kill switch: never touch this phone (flag file)")
    s.add_argument("device")
    s.add_argument("--adb-off", action="store_true", help="also turn wireless adb off on it and disconnect its routes")
    s.set_defaults(f=cmd_disable)
    s = sp.add_parser("enable")
    s.add_argument("device")
    s.set_defaults(f=cmd_enable)
    s = sp.add_parser("wait")
    s.add_argument("job")
    s.add_argument("--timeout", type=float, default=1800)
    s.add_argument("--poll", type=float, default=5)
    s.set_defaults(f=cmd_wait)
    s = sp.add_parser("results")
    s.add_argument("job")
    s.add_argument("--json", action="store_true", help="(cases suite prints text by default)")
    s.set_defaults(f=cmd_results)
    s = sp.add_parser("cancel", help="cancel pending parts of jobs (--running also stops a running part cleanly)")
    s.add_argument("job", nargs="+")
    s.add_argument("--running", action="store_true")
    s.set_defaults(f=cmd_cancel)
    s = sp.add_parser("bench", help="`bench publish`: merge the farm's bench rows into bench/results.jsonl + RESULTS.md on origin main now (farmd also does it by itself)")
    s.add_argument("what", choices=["publish"])
    s.set_defaults(f=cmd_bench)
    s = sp.add_parser("digest", help="one screen: devices, queue, latest result per ref/class and its difference vs main's latest daily")
    s.set_defaults(f=cmd_digest)
    s = sp.add_parser("diff", help="case-level status changes between two jobs")
    s.add_argument("a")
    s.add_argument("b")
    s.add_argument("--class", dest="cls", default="")
    s.set_defaults(f=cmd_diff)
    s = sp.add_parser("case", help="status of matching cases across all stored daily logs, newest last")
    s.add_argument("substring")
    s.set_defaults(f=cmd_case)
    s = sp.add_parser("log", help="kept test output (last 200 lines per test) of a smoke job part")
    s.add_argument("job")
    s.add_argument("--class", dest="cls", default="")
    s.add_argument("--grep", default="")
    s.add_argument("--tail", type=int, default=40)
    s.set_defaults(f=cmd_log)
    s = sp.add_parser("util", help="per-phone busy % and where the idle time went (from the farm's own records)")
    s.add_argument("--since", default="today", help="today | 6h | 2d | ISO time")
    s.set_defaults(f=cmd_util)
    s = sp.add_parser("sweep", help="idle sweep of the full dEQP-VK list: status | failures --class C [--group G] | on | off")
    s.add_argument("what", choices=("status", "failures", "on", "off"))
    s.add_argument("--class", dest="cls", default="")
    s.add_argument("--group", default="")
    s.set_defaults(f=cmd_sweep)
    s = sp.add_parser("bless", help="write a main daily job's result tsvs over the committed baselines in a checkout")
    s.add_argument("job")
    s.add_argument("--checkout", default=".", help="checkout whose vk/deqp/ours-daily-sample-*.tsv are overwritten (default: cwd)")
    s.set_defaults(f=cmd_bless)
    a = ap.parse_args()
    sys.exit(a.f(a) or 0)


if __name__ == "__main__":
    main()
