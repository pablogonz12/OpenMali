    "cube-720p": ("cube", "--scene cube --layers 8 --iters 24", "--size 1280x720 --windowed", "--size 1280x720"),
    "cube-native": ("cube", "--scene cube --layers 8 --iters 24", "", "--size 1280x720"),
}
