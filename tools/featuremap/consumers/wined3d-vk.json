{
  "consumer": "wined3d-vk",
  "title": "wined3d, Vulkan backend \u2014 D3D11 on Vulkan (renderer=vulkan; the route that is dominated by DXVK)",
  "ref": "wine",
  "kind": "vulkan",
  "note": "Rows are the conditions of the FL 10_0 test in feature_level_from_caps() (adapter_vk.c:2213-2226) and the FL 11_0 test (:2233-2243). They are ANDed per level: a false one falls back to the next lower level, it does not reject the adapter -- a game that asks for the level above what the device reaches still fails, so the route is not a workaround for a DXVK refusal.",
  "explicit": [
    {
      "id": "wined3d-vk-multi-viewport",
      "family": "feature",
      "vk": "multiViewport",
      "required": true,
      "file": "dlls/wined3d/adapter_vk.c",
      "line": 2216,
      "match": "info->features2.features.multiViewport"
    },
    {
